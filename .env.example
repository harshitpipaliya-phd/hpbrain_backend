# HP Enterprise Brain — Laravel backend
APP_NAME="HP Enterprise Brain"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- MySQL: your company database ---------------------------------------
# The Brain shares this database with the ERP. Every table it creates is
# hpbrain_-prefixed, so migrations cannot collide with institute_detail,
# org_details, hrms_departments, tbluser or tbluserprofilemaster.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSL=false

# --- Auth -----------------------------------------------------------------
JWT_SECRET=

# --- Frontend -------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# --- Runtime --------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug
QUEUE_CONNECTION=database
CACHE_STORE=database

# Neo4j is NOT required. ADR-008 defers it out of v1 — MySQL is the sole
# datastore, and login no longer depends on a graph database.

# AI (ADR-004). Empty AI_PROVIDER means NO provider, which is a valid and
# supported state: the reasoning verbs answer UNDETERMINED naming the gap
# rather than inventing text, and the golden intelligence-flow test asserts
# exactly that. Set to `anthropic` and supply a key to enable reasoning.
# Never commit a real key — this file is checked in.
AI_PROVIDER=
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
AI_TIMEOUT_SECONDS=30
