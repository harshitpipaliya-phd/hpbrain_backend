# Laravel application
/vendor
# Any depth, not just the root: contracts/node_modules is 2,000 files that a
# root-anchored `/node_modules` does not match, and un-ignoring /contracts made
# that immediately visible.
node_modules/

# Environment files — never commit real credentials
.env
.env.backup
.env.production

# Laravel cache and compiled files
/bootstrap/cache/*.php
/public/hot
/public/storage
/storage/*.key
/storage/logs/*.log
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*

# Composer
composer.phar

# NPM / Frontend build output
/web/dist

# Testing
/.phpunit.result.cache
/coverage

# IDE and OS files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Vercel
.vercel
.claude
/api

# /contracts, /docs and /adr were ignored, which meant the contract seam ADR-001
# calls "contract-enforced separation" was not under version control at all —
# nothing can be enforced that is not tracked. They are tracked now.
#
# /web stays ignored, but NOT because it should be: it contains its own .git
# pointing at a DIFFERENT GitHub remote from this repository, so it is an
# orphan nested repo rather than a submodule (there is no .gitmodules and no
# gitlink in this index). Un-ignoring it here would either swallow that history
# or create a broken gitlink. It needs a human decision — see the Module 9
# report — so it is left exactly as found.
/web


# Deployment artifacts
*.zip
*.tar.gz