DB_HOST=202.47.117.220
DB_PORT=3306
DB_DATABASE=hp_erp
DB_USERNAME=dev_db
DB_PASSWORD=dev@sql26
DB_SSL=false

# --- Auth -----------------------------------------------------------------
JWT_SECRET=74cb94e56b963f5fe967a7cd8f9dc7bf93e1565500fe051cff180aaf07ab33e3

