# If DB_HOST is NOT on this machine, read this before wondering why pages are
# slow. Measured against a remote host over the public internet:
#
#   connection handshake   ~1200 ms   (paid once per request without pooling)
#   a trivial `SELECT 1`   ~480 ms average, 39 ms best, 1505 ms worst
#
# At those numbers the cost of a page is set by HOW MANY queries it makes, not
# by how complex they are. An index cannot help; there is nothing slow at the
# server end. The only levers are: make fewer round trips, and stop paying the
# handshake on every request.
#
# DB_PERSISTENT keeps the connection open across requests in a PHP-FPM/Apache
# worker, removing the ~1200 ms handshake from all but each worker's first
# request. Leave it false under `php artisan serve` and on CLI. See the comment
# in config/database.php for the state-leakage and max_connections caveats.
DB_PERSISTENT=false

# Seconds to wait for a connection before giving up. The default is long enough
# that an unreachable database ties up a web worker rather than returning an
# error, which turns a database outage into an application outage.
DB_TIMEOUT=10

