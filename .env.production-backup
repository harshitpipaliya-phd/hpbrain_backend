# `database` is the WRONG cache store when DB_HOST is remote, and it is worth
# being explicit about why: a cache exists to be faster than recomputing the
# value, but a database-backed cache turns every get() into the very thing this
# deployment is slowest at — a ~480 ms network round trip. Caching then costs
# more than not caching, and the cache lookup on a miss is pure loss.
#
# `file` keeps entries on local disk: microseconds, no network, and correct for
# a single application server. Move to redis when there is more than one, since
# `file` is per-server and the entries would diverge.
CACHE_STORE=file

# Neo4j is NOT required. ADR-008 defers it out of v1 — MySQL is the sole
# datastore, and login no longer depends on a graph database.

# AI (ADR-004). Empty AI_PROVIDER means NO provider, which is a valid and
# supported state: the reasoning verbs answer UNDETERMINED naming the gap
# rather than inventing text, and the golden intelligence-flow test asserts
# exactly that. Set to `anthropic` and supply a key to enable reasoning.
# Never commit a real key — this file is checked in.
AI_PROVIDER=
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
AI_TIMEOUT_SECONDS=30
